{
  // TEMPLATE for the work-owned Cloudflare account. Wrangler configs do not inherit, so this file
  // is complete and standalone. Do NOT put real IDs here: copy it to a PRIVATE work repo as
  // wrangler.work.jsonc (default location ../../dalil-work/wrangler.work.jsonc, or set
  // DALIL_WORK_CONFIG) and fill in the placeholders there.
  // Deploy with the npm scripts (they pass -c for you): npm run work:deploy | work:migrate | work:secret | work:tail
  // Wrangler resolves main, assets.directory and migrations_dir relative to THIS file. In the private
  // repo, point them at the dalil checkout (e.g. "../dalil/worker/src/index.ts", "../dalil/worker/public",
  // "../dalil/worker/migrations"). Here they are relative to worker/ so the template dry-runs in place.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dalil-collector",
  "account_id": "<work-account-id>",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "routes": [{ "pattern": "dalil.example-corp.com", "custom_domain": true }],

  "vars": {
    "PUBLIC_BASE": "https://dalil.example-corp.com",
    "MAIL_FROM": "Dalil <dalil@example-corp.com>",
    "HOURLY_LIMIT": "20",
    // IANA timezone for dates on the list page, report page and digest.
    "TZ": "Asia/Amman",
    // Must equal the digest entry in triggers.crons below. Crons are UTC, so a DST zone drifts 1 h.
    "DIGEST_CRON": "0 6,18 * * *",
    // "0" turns all outbound email off (nothing is sent; digests mark rows done).
    "EMAIL_ENABLED": "1",
    // Entra ID is the Access identity provider. The Access application must BYPASS /v1/reports*
    // and /assets/* (public ingest and player assets); everything else stays behind Access.
    // Team domain: <team name>.cloudflareaccess.com; AUD: Access app -> Overview.
    "ACCESS_TEAM_DOMAIN": "<work-team>.cloudflareaccess.com",
    "ACCESS_AUD": "<work-access-aud-tag>"
  },
  // Secrets (never in this file): npm run work:secret -- RESEND_API_KEY

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dalil",
      "database_id": "<work-d1-database-id>",
      // Relative to this config; keep the path valid when the file lives in the private repo.
      "migrations_dir": "migrations"
    }
  ],

  "assets": { "directory": "./public", "binding": "ASSETS" },

  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "dalil-reports-work" }],

  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // Any integer unique within the work account (distinct from the personal deployment's 1001).
      "namespace_id": "2001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  "triggers": { "crons": ["17 3 * * *", "0 6,18 * * *"] },

  "observability": { "enabled": true }
}
