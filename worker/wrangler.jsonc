{
  // Dalil collector. See README.md for the one-time setup (D1, R2, secrets, Access).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dalil-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "routes": [{ "pattern": "dalil.thecourtspace.com", "custom_domain": true }],

  "vars": {
    // Used to build the triage link returned to the client and put in emails.
    "PUBLIC_BASE": "https://dalil.thecourtspace.com",
    // Resend sender. The domain must be verified in Resend.
    "MAIL_FROM": "Dalil <dalil@thecourtspace.com>",
    // D1-backed per ip+project cap (see README "Rate limiting").
    "HOURLY_LIMIT": "20",
    // Fill these after creating the Access application (Zero Trust -> Access -> Applications ->
    // the app's Overview shows the AUD tag; the team domain is <team name>.cloudflareaccess.com,
    // team name under Settings -> Custom pages). While empty, the reports list and status
    // changes are locked (403).
    "ACCESS_TEAM_DOMAIN": "wandering-heart-5762.cloudflareaccess.com",
    "ACCESS_AUD": "25938620ddb31058a6c2202de2689204afb37d6342bf65f34c9bb8b0ab93d4a0"
  },
  // Secrets (never in this file): RESEND_API_KEY -> `wrangler secret put RESEND_API_KEY`

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dalil",
      // Created 2026-10-08.
      "database_id": "ec023454-acdd-459f-a536-926c31f1a2ac",
      "migrations_dir": "migrations"
    }
  ],

  // Vendored rrweb-player (public/assets/rrweb-player.<ver>.js|css, see `npm run vendor:player`).
  // Served by the Worker through env.ASSETS so the report page's CSP can stay 'self'.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "dalil-reports" }],

  // Workers Rate Limiting only supports period 10 or 60 seconds, so "20 per hour" cannot
  // be expressed here. This binding is the burst guard (20/min per ip+project); the
  // hourly cap is enforced with a D1 count in src/ratelimit.ts.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // Placeholder: any integer unique within your account.
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  // "17 3 * * *" daily: delete rows past 90 days, retry failed per-report emails.
  // "0 6,18 * * *" (09:00 and 21:00 Asia/Amman): send the bug digest. src/index.ts branches on
  // the cron string, so keep it in sync with DIGEST_CRON in src/digest.ts.
  "triggers": { "crons": ["17 3 * * *", "0 6,18 * * *"] },

  "observability": { "enabled": true }
}
